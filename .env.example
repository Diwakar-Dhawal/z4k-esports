# Supabase — copy to .env.local and fill from your Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# HL Gaming BGMI UID verification (https://www.hlgamingofficial.com/p/bgmi-verify-api.html)
# Server-only — the browser never sees these. Leave blank to skip live verification.
HL_GAMING_DEV_UID=
HL_GAMING_API_KEY=
